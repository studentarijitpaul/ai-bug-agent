# GitHub Configuration
# Optional for public repository inspection, recommended to avoid rate limits (60/hr -> 5,000/hr)
# Use a personal access token (PAT) or fine-grained token with read-only 'Issues' and 'Metadata' access
GITHUB_TOKEN=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application Database path
DATABASE_PATH=tasks.db

# Future Milestone Placeholders (Do not enter real credentials in example file)
# GMAIL_CLIENT_SECRETS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json
# APPROVER_EMAIL=you@example.com
