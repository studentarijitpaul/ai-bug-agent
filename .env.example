# GitHub Configuration
# Optional for public repository inspection, recommended to avoid rate limits (60/hr -> 5,000/hr)
# Use a personal access token (PAT) or fine-grained token with read-only 'Issues' and 'Metadata' access
GITHUB_TOKEN=

# Offline Defect Analysis:
# No OpenAI API key or paid AI service required. Bug analysis is fully offline and deterministic.

# Human Approval via Gmail OAuth (Optional, only needed when sending/checking approval emails):
# Never commit credentials.json, token.json, or refresh tokens to version control.
# Read credentials from process environment variables or GitHub Actions Secrets.
# GMAIL_TOKEN_JSON: JSON string containing authorized-user credentials with refresh_token
# GMAIL_CREDENTIALS_JSON: JSON string containing Google OAuth client secrets (installed/web application)
# APPROVER_EMAIL: Authorized reviewer email address (e.g. dev@example.com)
GMAIL_TOKEN_JSON=
GMAIL_CREDENTIALS_JSON=
APPROVER_EMAIL=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application Database path
DATABASE_PATH=tasks.db
